# Copy this file to .env for local development. Never commit real credentials.
POSTGRES_DB=evidenceclass
POSTGRES_USER=evidenceclass
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://evidenceclass:replace-with-a-local-password@127.0.0.1:5432/evidenceclass

REDIS_PASSWORD=replace-with-a-local-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-local-password@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:replace-with-a-local-password@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-local-password@127.0.0.1:6379/0

# Phase 8 API/Worker. Use "manual" only for deterministic acceptance.
EVIDENCECLASS_AUTH_SECRET=replace-with-at-least-32-random-characters
EVIDENCECLASS_WORKER_MODE=celery
EVIDENCECLASS_CREATE_SCHEMA=0
EVIDENCECLASS_OBJECT_STORE=minio

MINIO_ROOT_USER=replace-with-a-local-access-key
MINIO_ROOT_PASSWORD=replace-with-a-local-secret-key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-a-local-access-key
MINIO_SECRET_KEY=replace-with-a-local-secret-key
MINIO_BUCKET=evidenceclass
MINIO_SECURE=false

# Phase 4 real-model path. The application never supplies a paid-model default.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-a-server-side-api-key
OPENAI_MODEL=choose-an-explicit-compatible-model
# Optional accounting rates. Leave blank to record cost as unknown rather than inventing it.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

# Optional temporary local functional model; never committed as an absolute user path.
LOCAL_QWEN_MODEL_PATH=replace-with-local-qwen-checkpoint-path
