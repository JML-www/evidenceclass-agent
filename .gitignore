# Python虚拟环境
.venv/
venv/
env/

# Python编译缓存
__pycache__/
*.py[cod]
*$py.class

# 测试缓存
.pytest_cache/

# ruff linter缓存
.ruff_cache/

# 环境变量，忽略真实密钥，保留示例模板
.env
.env.*
!.env.example

# Python包构建元信息
*.egg-info/
*.egg
dist/
build/

# 前端依赖
node_modules/

# 本地存储、训练输出
storage/
runs/
models/

# 媒体大文件
*.mp4
*.mov
*.mkv
*.wav
*.srt

# IDE项目配置
.idea/
.vscode/
*.iml

# 操作系统垃圾文件
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/

# Coverage reports
.coverage
coverage.xml
htmlcov/

# jupyter notebook
.ipynb_checkpoints/

# mypy类型检查缓存
.mypy_cache/
